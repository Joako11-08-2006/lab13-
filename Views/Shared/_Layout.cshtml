<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Laboratorio 13</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">Laboratorio 13</a>
    <ul class="navbar-nav">
      <li class="nav-item"><a class="nav-link" asp-controller="Grades" asp-action="Index">Grados</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">Cursos</a></li>
    </ul>
  </div>
</nav>
<div class="container">@RenderBody()</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
