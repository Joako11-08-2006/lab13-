@model Course
@{ ViewData["Title"] = "Eliminar"; }
<h2>¿Eliminar este registro?</h2>
<dl class="row">
<dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt><dd class="col-sm-10">@Model.Name</dd>
<dt class="col-sm-2">@Html.DisplayNameFor(m => m.Credit)</dt><dd class="col-sm-10">@Model.Credit</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.IdCourse">
<input type="hidden" asp-for="IdCourse" />
<button type="submit" class="btn btn-danger">Eliminar</button>
<a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
