@model Course
@{ ViewData["Title"] = "Editar"; }
<h2>Editar Course</h2>
<form asp-action="Edit" asp-route-id="@Model.IdCourse">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="IdCourse" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label>
<input asp-for="Name" class="form-control" />
<span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Credit" class="form-label"></label>
<input asp-for="Credit" class="form-control" />
<span asp-validation-for="Credit" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Guardar</button>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
