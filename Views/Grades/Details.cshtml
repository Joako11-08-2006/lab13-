@model Grade
@{ ViewData["Title"] = "Detalle"; }
<h2>Detalle Grade</h2>
<dl class="row">
<dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt><dd class="col-sm-10">@Model.Name</dd>
<dt class="col-sm-2">@Html.DisplayNameFor(m => m.Description)</dt><dd class="col-sm-10">@Model.Description</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdGrade">Editar</a> | <a asp-action="Index">Volver</a>
