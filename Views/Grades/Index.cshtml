@model IEnumerable<Grade>
@{ ViewData["Title"] = "Grados"; }
<h2>Grados</h2>
<p><a class="btn btn-primary" asp-action="Create">Nuevo</a></p>
<table class="table table-striped">
<thead><tr><th>Id</th><th>@Html.DisplayNameFor(m => m.Name)</th><th>@Html.DisplayNameFor(m => m.Description)</th><th></th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.IdGrade</td><td>@item.Name</td><td>@item.Description</td>
<td><a asp-action="Edit" asp-route-id="@item.IdGrade">Editar</a> |
<a asp-action="Details" asp-route-id="@item.IdGrade">Detalle</a> |
<a asp-action="Delete" asp-route-id="@item.IdGrade">Eliminar</a></td></tr>
}
</tbody></table>
